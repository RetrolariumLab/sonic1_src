  "delta": [
    {
      "id": "fresh_text_import",
      "kind": "source",
      "summary": "Import the public AS source snapshot into an independent text-only history; remove binary content, audio content, editor projects and bundled tools.",
      "evidence": ["source_boundary", "private_inputs", "provenance_and_unknowns"]
    },
    {
      "id": "private_inputs_and_build",
      "kind": "tooling",
      "summary": "Extract profile-owned ROM assets and decoded DPCM samples, pin Kit tools and verify all official revisions byte for byte; specialize community-only switches to original behavior.",
      "evidence": ["canonical_identity", "reproducible_build"]
    },
    {
      "id": "style_and_relocation",
      "kind": "tooling",
      "summary": "Apply Kit formatting through a reversible AS-field adapter, classify numeric operands, declare hardware boundaries and build timing-preserving moved-source probes.",
      "evidence": ["baseline_validation", "symbolic_pointers"]
    },
    {
      "id": "runtime_and_release",
      "kind": "evidence",
      "summary": "Record original-input goldens for every profile and enforce sequential relocated checks, current documentation, provenance and the complete clean-tree aggregate gate.",
      "evidence": ["runtime_coverage", "baseline_documentation", "release_contract"]
    }
  ],
